{
  "name": "golos-dushi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://nixiers.github.io/golosdyshii/",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
